# Copy this file to .env. Never commit .env.
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
# Recommended for local development: opens Snowflake login in your browser.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
SNOWFLAKE_ROLE=DATAMIND_READER

# Local Gemma through Ollama. Gemma does planning; Snowflake does computation.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b
